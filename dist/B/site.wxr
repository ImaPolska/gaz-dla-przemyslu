<!-- /wp:paragraph -->
<!-- wp:heading -->
<h2 class="wp-block-heading">Odbiorcy danych i okres przechowywania</h2>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p>[[treść dostarczy zleceniodawca]]</p>
<!-- /wp:paragraph -->
<!-- wp:heading -->
<h2 class="wp-block-heading">Prawa i kontakt w sprawach danych</h2>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p>[[treść dostarczy zleceniodawca]]</p>
<!-- /wp:paragraph -->
<!-- wp:heading -->
<h2 class="wp-block-heading">Pliki cookie</h2>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p>[[treść dostarczy zleceniodawca; slot CMP: etap późniejszy]]</p>
