<item>
<title><![CDATA[Kontakt]]></title>
<link>https://gazdlaprzemyslu.example.invalid/kontakt/</link>
<dc:creator><![CDATA[admin]]></dc:creator>
<guid isPermaLink="false">https://gazdlaprzemyslu.example.invalid/?p=204</guid>
<description></description>
<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Kontakt: strona pomocnicza"},"templateLock":"contentOnly","className":"gdp-section gdp-stub-hero gdp-contact"} -->
<div class="wp-block-group gdp-section gdp-stub-hero gdp-contact">
<!-- wp:paragraph {"className":"gdp-eyebrow"} -->
<p class="gdp-eyebrow">POROZMAWIAJMY O TWOJEJ UMOWIE</p>
<!-- /wp:paragraph -->
<!-- wp:heading {"level":1} -->
<h1 class="wp-block-heading">Kontakt z PBM.</h1>
<!-- /wp:heading -->
<!-- wp:paragraph {"className":"gdp-lead"} -->
<p class="gdp-lead">To strona kontaktowa prototypu Gaz dla Przemysłu. Dane kontaktowe zostaną uzupełnione przez PBM. Nie wpisuj danych ani nie próbuj przesyłać dokumentów: formularz jest wyłącznie demonstracją układu.</p>
<!-- /wp:paragraph -->
<!-- wp:heading -->
<h2 class="wp-block-heading">Dane do uzupełnienia</h2>
<!-- /wp:heading -->
<!-- wp:list -->
<ul class="wp-block-list">
<!-- wp:list-item -->
<li>PBM Sp. z o.o., Grupa IMA Polska</li>
<!-- /wp:list-item -->
<!-- wp:list-item -->
<li>Adres: [[adres siedziby]]</li>
<!-- /wp:list-item -->
<!-- wp:list-item -->
<li>Email: [[adres e-mail]]</li>
<!-- /wp:list-item -->
<!-- wp:list-item -->
<li>Telefon: [[numer telefonu]]</li>
<!-- /wp:list-item -->
<!-- wp:list-item -->
<li>Godziny kontaktu: [[godziny]]</li>
<!-- /wp:list-item -->
<!-- wp:list-item -->
<li>Dane rejestrowe: [[NIP, KRS, kapitał zakładowy]]</li>
<!-- /wp:list-item -->
</ul>
<!-- /wp:list -->
<!-- wp:paragraph -->
<p>[[Miejsce na mapę: bez osadzenia zewnętrznego]]</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Formularz kontaktowy: demonstracja"},"templateLock":"contentOnly","className":"gdp-section gdp-contact-slot"} -->
<div class="wp-block-group gdp-section gdp-contact-slot">
<!-- wp:block {"ref":101} /-->
<!-- wp:paragraph -->
<p><a href="/">Wróć na stronę główną</a> lub <a href="/oferta/cena-stala/">poznaj cenę stałą</a>.</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
]]></content:encoded>
