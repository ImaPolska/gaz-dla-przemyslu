<item>
<title><![CDATA[Wgraj fakturę]]></title>
<link>https://gazdlaprzemyslu.example.invalid/wgraj-fakture/</link>
<dc:creator><![CDATA[admin]]></dc:creator>
<guid isPermaLink="false">https://gazdlaprzemyslu.example.invalid/?p=206</guid>
<description></description>
<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Wgraj fakturę: strona pomocnicza"},"templateLock":"contentOnly","className":"gdp-section gdp-stub-hero"} -->
<div class="wp-block-group gdp-section gdp-stub-hero">
<!-- wp:paragraph {"className":"gdp-eyebrow"} -->
<p class="gdp-eyebrow">DANE DO ROZMOWY</p>
<!-- /wp:paragraph -->
<!-- wp:heading {"level":1} -->
<h1 class="wp-block-heading">Zacznij od faktury za gaz.</h1>
<!-- /wp:heading -->
<!-- wp:paragraph {"className":"gdp-lead"} -->
<p class="gdp-lead">Faktura będzie punktem wyjścia do zebrania informacji o zużyciu i obecnych rozliczeniach. W tym prototypie nie można wybrać ani przesłać pliku. Pokazujemy wyłącznie przyszły układ formularza.</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Upload faktury: demonstracja"},"templateLock":"contentOnly","className":"gdp-section gdp-upload-section"} -->
<div class="wp-block-group gdp-section gdp-upload-section">
<!-- wp:block {"ref":101} /-->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Zakres danych i bezpieczeństwo: zapowiedź"},"templateLock":"contentOnly","className":"gdp-section gdp-upload-info"} -->
<div class="wp-block-group gdp-section gdp-upload-info">
<!-- wp:heading -->
<h2 class="wp-block-heading">Co będzie potrzebne?</h2>
<!-- /wp:heading -->
<!-- wp:list -->
<ul class="wp-block-list">
<!-- wp:list-item -->
<li>Dane punktów poboru i zużycie gazu</li>
<!-- /wp:list-item -->
<!-- wp:list-item -->
<li>Okres rozliczenia i składniki obecnej ceny</li>
<!-- /wp:list-item -->
<!-- wp:list-item -->
<li>Obecna umowa oraz planowany okres dostaw</li>
<!-- /wp:list-item -->
</ul>
<!-- /wp:list -->
<!-- wp:paragraph -->
<p>Zakres odczytu, zasady przetwarzania i retencja: [[dostarczy zleceniodawca]]. Prototyp nie przechowuje przesyłanych faktur, ponieważ nie przyjmuje plików.</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph -->
<p><a href="/polityka-prywatnosci/">Polityka prywatności: treść do uzupełnienia</a></p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
]]></content:encoded>
