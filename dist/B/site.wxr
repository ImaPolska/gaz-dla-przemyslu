<item>
<title><![CDATA[CTA: wgraj fakturę]]></title>
<link>https://gazdlaprzemyslu.example.invalid/?post_type=wp_block&amp;name=final-cta</link>
<dc:creator><![CDATA[admin]]></dc:creator>
<guid isPermaLink="false">https://gazdlaprzemyslu.example.invalid/?p=103</guid>
<description></description>
<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"CTA: wgraj fakturę"},"templateLock":"contentOnly","className":"gdp-final-inner"} -->
<div class="wp-block-group gdp-final-inner">
<!-- wp:group {"metadata":{"name":"Treść wezwania"},"className":"gdp-final-copy"} -->
<div class="wp-block-group gdp-final-copy">
<!-- wp:paragraph {"className":"gdp-eyebrow"} -->
<p class="gdp-eyebrow">ZACZNIJ OD SWOICH DANYCH</p>
<!-- /wp:paragraph -->
<!-- wp:heading {"metadata":{"name":"Tytuł CTA","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<h2 class="wp-block-heading">Porozmawiajmy o Twojej umowie.</h2>
<!-- /wp:heading -->
<!-- wp:paragraph {"metadata":{"name":"Podtytuł CTA","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p>Przygotuj fakturę i sprawdź, jakie informacje będą potrzebne do rozmowy o warunkach.</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Przycisk kontaktowy"},"className":"gdp-final-action"} -->
<div class="wp-block-group gdp-final-action">
<!-- wp:buttons -->
<div class="wp-block-buttons">
<!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/kontakt/">Wgraj fakturę</a></div>
<!-- /wp:button -->
</div>
<!-- /wp:buttons -->
<!-- wp:paragraph {"className":"gdp-small"} -->
<p class="gdp-small">Prototyp: przejdziesz do kontaktu, bez przesyłania pliku.</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
</div>
<!-- /wp:group -->
]]></content:encoded>
