<item>
<title><![CDATA[Slot: upload faktury]]></title>
<link>https://gazdlaprzemyslu.example.invalid/?post_type=wp_block&amp;name=upload</link>
<dc:creator><![CDATA[admin]]></dc:creator>
<guid isPermaLink="false">https://gazdlaprzemyslu.example.invalid/?p=101</guid>
<description></description>
<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Slot: upload faktury"},"templateLock":"contentOnly","className":"gdp-upload"} -->
<div class="wp-block-group gdp-upload">
<!-- wp:paragraph {"className":"gdp-eyebrow"} -->
<p class="gdp-eyebrow">TWOJA FAKTURA. PUNKT WYJŚCIA.</p>
<!-- /wp:paragraph -->
<!-- wp:heading -->
<h2 class="wp-block-heading">Sprawdź warunki dla swojej firmy</h2>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p>Faktura pomoże określić profil zużycia i zakres zapytania.</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph {"className":"gdp-file-slot"} -->
<p class="gdp-file-slot">[[Miejsce na plik faktury: pole nieaktywne]]</p>
<!-- /wp:paragraph -->
<!-- wp:group {"metadata":{"name":"Dane kontaktowe: atrapa"},"className":"gdp-fields"} -->
<div class="wp-block-group gdp-fields">
<!-- wp:paragraph {"className":"gdp-field"} -->
<p class="gdp-field"><strong>Email</strong> [[adres e-mail]]</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph {"className":"gdp-field"} -->
<p class="gdp-field"><strong>Telefon</strong> [[numer telefonu]]</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph {"className":"gdp-field"} -->
<p class="gdp-field"><strong>NIP</strong> [[NIP firmy]]</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
<!-- wp:buttons -->
<div class="wp-block-buttons">
<!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/kontakt/">Wgraj fakturę</a></div>
<!-- /wp:button -->
</div>
<!-- /wp:buttons -->
<!-- wp:paragraph {"className":"gdp-prototype-note"} -->
<p class="gdp-prototype-note"><strong>Prototyp. Formularz nie przesyła danych.</strong> Przycisk prowadzi do kontaktu.</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph {"className":"gdp-small"} -->
<p class="gdp-small">Oferta indykatywna w 24 h: roboczy, niepotwierdzony cel obsługi z briefu. Nie jest gwarancją terminu ani działającą usługą w prototypie.</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph {"className":"gdp-consent"} -->
<p class="gdp-consent">[[treść zgody dostarczy zleceniodawca]]. <a href="/polityka-prywatnosci/">Polityka prywatności</a>.</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
]]></content:encoded>
<excerpt:encoded><![CDATA[]]></excerpt:encoded>
