<!-- /wp:list-item -->
<!-- wp:list-item -->
<li><a href="/dla-doradcow/">Współpraca doradcy</a> — model obsługi i reprezentacja.</li>
<!-- /wp:list-item -->
<!-- wp:list-item -->
<li><a href="/analiza-umowy/">Analiza umowy</a> — najpierw zakres dokumentów, bez wysyłki w prototypie.</li>
