<wp:post_date_gmt><![CDATA[2000-01-01 00:00:00]]></wp:post_date_gmt>
<wp:post_modified><![CDATA[2000-01-01 00:00:00]]></wp:post_modified>
<wp:post_modified_gmt><![CDATA[2000-01-01 00:00:00]]></wp:post_modified_gmt>
<wp:comment_status><![CDATA[closed]]></wp:comment_status>
<wp:ping_status><![CDATA[closed]]></wp:ping_status>
<wp:post_name><![CDATA[analiza-umowy]]></wp:post_name>
<wp:status><![CDATA[publish]]></wp:status>
<wp:post_parent>0</wp:post_parent>
<wp:menu_order>0</wp:menu_order>
<wp:post_type><![CDATA[page]]></wp:post_type>
<wp:post_password><![CDATA[]]></wp:post_password>
<wp:is_sticky>0</wp:is_sticky>
<wp:postmeta><wp:meta_key><![CDATA[_gdp_import_id]]></wp:meta_key><wp:meta_value><![CDATA[214]]></wp:meta_value></wp:postmeta>
<wp:postmeta><wp:meta_key><![CDATA[_gdp_source_file]]></wp:meta_key><wp:meta_value><![CDATA[content/pages/analiza-umowy.html]]></wp:meta_value></wp:postmeta>
<wp:postmeta><wp:meta_key><![CDATA[ct_page_title]]></wp:meta_key><wp:meta_value><![CDATA[no]]></wp:meta_value></wp:postmeta>
</item>
<item>
<title><![CDATA[Gaz dla Twojej firmy]]></title>
<link>https://gazdlaprzemyslu.example.invalid/dla-kogo/</link>
<dc:creator><![CDATA[admin]]></dc:creator>
<guid isPermaLink="false">https://gazdlaprzemyslu.example.invalid/?p=215</guid>
<description></description>
<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Otwarcie: Zacznij od tego, jak pracuje Twoja firma."},"templateLock":"contentOnly","className":"gdp-section gdp-product-hero"} -->
<div class="wp-block-group gdp-section gdp-product-hero">
<!-- wp:heading {"level":1} -->
<h1 class="wp-block-heading">Zacznij od tego, jak pracuje Twoja firma.</h1>
<!-- /wp:heading -->
<!-- wp:paragraph {"className":"gdp-lead"} -->
<p class="gdp-lead">Inaczej przygotowuje zakup zakład przemysłowy, inaczej mniejsza firma, a inaczej doradca reprezentujący portfel klientów. Wybierz ścieżkę, by zobaczyć potrzebne dane i pytania do rozmowy. Próg zużycia pozostaje roboczy.</p>
<!-- /wp:paragraph -->
<!-- wp:buttons -->
<div class="wp-block-buttons">
<!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="#segmenty">Wybierz ścieżkę</a></div>
<!-- /wp:button -->
</div>
<!-- /wp:buttons -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Segmenty klientów"},"templateLock":"contentOnly","className":"gdp-section","anchor":"segmenty"} -->
<div class="wp-block-group gdp-section" id="segmenty">
<!-- wp:heading -->
<h2 class="wp-block-heading">Twój profil zakupu</h2>
<!-- /wp:heading -->
<!-- wp:block {"ref":105} /-->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Źródła i aktualizacja"},"templateLock":"contentOnly","className":"gdp-section"} -->
<div class="wp-block-group gdp-section">
<!-- wp:heading -->
<h2 class="wp-block-heading">Źródła i aktualizacja</h2>
<!-- /wp:heading -->
<!-- wp:list -->
<ul class="wp-block-list">
<!-- wp:list-item -->
<li>[[warunki produktu PBM — dokument do zatwierdzenia]]</li>
<!-- /wp:list-item -->
<!-- wp:list-item -->
<li>[[źródło: dokument, wersja i link po weryfikacji merytorycznej]]</li>
<!-- /wp:list-item -->
</ul>
<!-- /wp:list -->
<!-- wp:paragraph {"className":"gdp-small"} -->
<p class="gdp-small">Ostatnia aktualizacja: [[data]]. Autor: [[autor]].</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph {"className":"gdp-small"} -->
<p class="gdp-small">Materiał roboczy. Zakres oferty i odwołania do źródeł wymagają zatwierdzenia przed publikacją.</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Następny krok"},"templateLock":"contentOnly","className":"gdp-section gdp-final"} -->
<div class="wp-block-group gdp-section gdp-final">
<!-- wp:block {"ref":103,"content":{"Tytuł CTA":{"content":"Przygotuj dane do rozmowy."},"Podtytuł CTA":{"content":"Faktura i obecna umowa pozwolą uporządkować pytania o Twój zakup gazu."}}} /-->
</div>
<!-- /wp:group -->
]]></content:encoded>
<excerpt:encoded><![CDATA[]]></excerpt:encoded>
<wp:post_id>215</wp:post_id>
