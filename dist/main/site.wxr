<item>
<title><![CDATA[Pasek zaufania]]></title>
<link>https://gazdlaprzemyslu.example.invalid/?post_type=wp_block&amp;name=trust</link>
<dc:creator><![CDATA[admin]]></dc:creator>
<guid isPermaLink="false">https://gazdlaprzemyslu.example.invalid/?p=106</guid>
<description></description>
<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Pasek zaufania"},"templateLock":"contentOnly","className":"gdp-trust-grid"} -->
<div class="wp-block-group gdp-trust-grid">
<!-- wp:group {"metadata":{"name":"Podmiot"},"className":"gdp-trust-item"} -->
<div class="wp-block-group gdp-trust-item">
<!-- wp:paragraph {"metadata":{"name":"Podmiot: tekst","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p><strong>PBM Sp. z o.o.</strong></p>
<!-- /wp:paragraph -->
<!-- wp:paragraph -->
<p>Kanał Gaz dla Przemysłu</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Grupa"},"className":"gdp-trust-item"} -->
<div class="wp-block-group gdp-trust-item">
<!-- wp:paragraph {"metadata":{"name":"Grupa: tekst","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p><strong>Grupa IMA Polska</strong></p>
<!-- /wp:paragraph -->
<!-- wp:paragraph -->
<p>Przemysł i energetyka odnawialna</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Koncesja"},"className":"gdp-trust-item"} -->
<div class="wp-block-group gdp-trust-item">
<!-- wp:paragraph {"metadata":{"name":"Koncesja: tekst","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p><strong>Koncesja OPG: [[ ]]</strong></p>
<!-- /wp:paragraph -->
<!-- wp:paragraph -->
<p>Numer i dokument do uzupełnienia</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Aktywa Grupy"},"className":"gdp-trust-item"} -->
<div class="wp-block-group gdp-trust-item">
<!-- wp:paragraph {"metadata":{"name":"Aktywa: tekst","bindings":{"__default":{"source":"core/pattern-overrides"}}}} -->
<p><strong>Aktywa Grupy: [[ ]]</strong></p>
<!-- /wp:paragraph -->
<!-- wp:paragraph -->
<p>Opis i dane do potwierdzenia</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
</div>
<!-- /wp:group -->
]]></content:encoded>
