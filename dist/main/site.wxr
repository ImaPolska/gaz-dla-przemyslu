<wp:post_parent>202</wp:post_parent>
<wp:menu_order>0</wp:menu_order>
<wp:post_type><![CDATA[page]]></wp:post_type>
<wp:post_password><![CDATA[]]></wp:post_password>
<wp:is_sticky>0</wp:is_sticky>
<wp:postmeta><wp:meta_key><![CDATA[_gdp_import_id]]></wp:meta_key><wp:meta_value><![CDATA[203]]></wp:meta_value></wp:postmeta>
<wp:postmeta><wp:meta_key><![CDATA[_gdp_source_file]]></wp:meta_key><wp:meta_value><![CDATA[content/pages/cena-stala.html]]></wp:meta_value></wp:postmeta>
