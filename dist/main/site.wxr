<item>
<title><![CDATA[Nie znaleziono strony]]></title>
<link>https://gazdlaprzemyslu.example.invalid/blad-404/</link>
<dc:creator><![CDATA[admin]]></dc:creator>
<guid isPermaLink="false">https://gazdlaprzemyslu.example.invalid/?p=224</guid>
<description></description>
<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Otwarcie: Nie znaleźliśmy tej strony."},"templateLock":"contentOnly","className":"gdp-section gdp-product-hero"} -->
<div class="wp-block-group gdp-section gdp-product-hero">
<!-- wp:heading {"level":1} -->
<h1 class="wp-block-heading">Nie znaleźliśmy tej strony.</h1>
<!-- /wp:heading -->
<!-- wp:paragraph {"className":"gdp-lead"} -->
<p class="gdp-lead">Adres może być niepełny albo nie prowadzi już do dostępnej treści. Wróć na stronę główną lub zacznij od przygotowania faktury do rozmowy o gazie. Żadne dane nie zostały wysłane przez tę stronę.</p>
<!-- /wp:paragraph -->
<!-- wp:buttons -->
<div class="wp-block-buttons">
<!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/">Wróć na stronę główną</a></div>
<!-- /wp:button -->
</div>
<!-- /wp:buttons -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Wybierz następny krok"},"templateLock":"contentOnly","className":"gdp-section"} -->
<div class="wp-block-group gdp-section">
<!-- wp:heading -->
<h2 class="wp-block-heading">Wybierz następny krok</h2>
<!-- /wp:heading -->
<!-- wp:buttons -->
<div class="wp-block-buttons">
<!-- wp:button {"className":"is-style-outline"} -->
<div class="wp-block-button is-style-outline"><a class="wp-block-button__link wp-element-button" href="/wgraj-fakture/">Wgraj fakturę</a></div>
<!-- /wp:button -->
</div>
<!-- /wp:buttons -->
<!-- wp:list -->
<ul class="wp-block-list">
<!-- wp:list-item -->
<li><a href="/oferta/">Porównaj modele zakupu</a></li>
<!-- /wp:list-item -->
<!-- wp:list-item -->
<li><a href="/wiedza/">Poszukaj odpowiedzi w bazie wiedzy</a></li>
<!-- /wp:list-item -->
<!-- wp:list-item -->
<li><a href="/kontakt/">Sprawdź kontakt do PBM</a></li>
<!-- /wp:list-item -->
</ul>
<!-- /wp:list -->
</div>
<!-- /wp:group -->
]]></content:encoded>
