<description></description>
<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Otwarcie: Regulamin serwisu"},"templateLock":"contentOnly","className":"gdp-section gdp-product-hero"} -->
<div class="wp-block-group gdp-section gdp-product-hero">
<!-- wp:heading {"level":1} -->
<h1 class="wp-block-heading">Regulamin serwisu</h1>
<!-- /wp:heading -->
<!-- wp:paragraph {"className":"gdp-lead"} -->
<p class="gdp-lead">To struktura dokumentu do uzupełnienia i zatwierdzenia przez zleceniodawcę. Nie jest gotową polityką ani regulaminem. Prototyp nie uruchamia formularzy, uploadu i integracji; docelowe zasady wymagają dopasowania do rzeczywistego procesu.</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Podmiot i zakres serwisu"},"templateLock":"contentOnly","className":"gdp-section"} -->
