<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Slot: zgłoszenie doradcy"},"templateLock":"contentOnly","className":"gdp-upload"} -->
<div class="wp-block-group gdp-upload">
<!-- wp:heading -->
<h2 class="wp-block-heading">Zgłoszenie doradcy</h2>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p>Przedstaw swój model obsługi klientów. Nie przesyłaj danych klientów bez potwierdzenia uprawnienia i zasad przekazania.</p>
<!-- /wp:paragraph -->
<!-- wp:group {"metadata":{"name":"Pola demonstracyjne"},"templateLock":"contentOnly","className":"gdp-fields"} -->
<div class="wp-block-group gdp-fields">
<!-- wp:paragraph {"className":"gdp-field"} -->
<p class="gdp-field"><strong>Imię i nazwisko</strong> [[imię i nazwisko]]</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph {"className":"gdp-field"} -->
<p class="gdp-field"><strong>Firma / NIP</strong> [[dane doradcy]]</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph {"className":"gdp-field"} -->
<p class="gdp-field"><strong>E-mail / telefon</strong> [[dane kontaktowe]]</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph {"className":"gdp-field"} -->
<p class="gdp-field"><strong>Profil obsługiwanych firm</strong> [[branże i sposób pracy]]</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph {"className":"gdp-field"} -->
<p class="gdp-field"><strong>Zakres współpracy</strong> [[zapytania indywidualne lub portfel klientów]]</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
<!-- wp:buttons -->
<div class="wp-block-buttons">
<!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/kontakt/">Zgłoś się</a></div>
<!-- /wp:button -->
</div>
<!-- /wp:buttons -->
<!-- wp:paragraph {"className":"gdp-prototype-note"} -->
<p class="gdp-prototype-note">Prototyp: pola są nieaktywne. Przycisk prowadzi do kontaktu i nie przesyła danych.</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph {"className":"gdp-consent"} -->
<p class="gdp-consent">[[treść zgody dostarczy zleceniodawca]]. <a href="/polityka-prywatnosci/">Polityka prywatności</a>.</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
]]></content:encoded>
