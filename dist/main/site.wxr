<item>
<title><![CDATA[Wiedza]]></title>
<link>https://gazdlaprzemyslu.example.invalid/wiedza/</link>
<dc:creator><![CDATA[admin]]></dc:creator>
<guid isPermaLink="false">https://gazdlaprzemyslu.example.invalid/?p=205</guid>
<description></description>
<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Otwarcie: Wiedza, która porządkuje decyzję o gazie."},"templateLock":"contentOnly","className":"gdp-section gdp-product-hero"} -->
<div class="wp-block-group gdp-section gdp-product-hero">
<!-- wp:heading {"level":1} -->
<h1 class="wp-block-heading">Wiedza, która porządkuje decyzję o gazie.</h1>
<!-- /wp:heading -->
<!-- wp:paragraph {"className":"gdp-lead"} -->
<p class="gdp-lead">Baza wiedzy pomaga przygotować pytania o zmianę sprzedawcy, umowę i model ceny. Artykuły są robocze; wymagające potwierdzenia źródła i terminy są oznaczone. Wybierz temat, przeczytaj listę kontrolną i wróć do dokumentów swojej firmy.</p>
<!-- /wp:paragraph -->
<!-- wp:buttons -->
<div class="wp-block-buttons">
<!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/wgraj-fakture/">Wgraj fakturę</a></div>
<!-- /wp:button -->
</div>
<!-- /wp:buttons -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Wybierz temat"},"templateLock":"contentOnly","className":"gdp-section"} -->
<div class="wp-block-group gdp-section">
<!-- wp:heading -->
<h2 class="wp-block-heading">Wybierz temat</h2>
<!-- /wp:heading -->
<!-- wp:group {"metadata":{"name":"Kategorie wiedzy"},"templateLock":"contentOnly","className":"gdp-audience-grid"} -->
<div class="wp-block-group gdp-audience-grid">
<!-- wp:group {"metadata":{"name":"Zmiana sprzedawcy"},"templateLock":"contentOnly","className":"gdp-audience-card"} -->
<div class="wp-block-group gdp-audience-card">
<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">Zmiana sprzedawcy</h3>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p>Kolejność działań, komplet dokumentów i punkty kontrolne.</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph -->
<p><a href="/category/zmiana-sprzedawcy/">Zobacz: zmiana sprzedawcy</a></p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Umowy i wypowiedzenia"},"templateLock":"contentOnly","className":"gdp-audience-card"} -->
<div class="wp-block-group gdp-audience-card">
<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">Umowy i wypowiedzenia</h3>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p>Okres umowy, przedłużenie i pytania do weryfikacji prawnej.</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph -->
<p><a href="/category/umowy-i-wypowiedzenia/">Zobacz: umowy i wypowiedzenia</a></p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Ceny i rynek"},"templateLock":"contentOnly","className":"gdp-audience-card"} -->
<div class="wp-block-group gdp-audience-card">
<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">Ceny i rynek</h3>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p>Mechanizm ceny, profil zużycia i porównanie warunków.</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph -->
<p><a href="/category/ceny-i-rynek/">Zobacz: ceny i rynek</a></p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Biometan i raportowanie"},"templateLock":"contentOnly","className":"gdp-audience-card"} -->
<div class="wp-block-group gdp-audience-card">
<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">Biometan i raportowanie</h3>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p>Miejsce na materiały o dokumentacji i raportowaniu. Pierwszy artykuł: [[w przygotowaniu]].</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph -->
<p><a href="/category/biometan-i-raportowanie/">Zobacz: biometan i raportowanie</a></p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Sprzedaż rezerwowa"},"templateLock":"contentOnly","className":"gdp-audience-card"} -->
<div class="wp-block-group gdp-audience-card">
<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">Sprzedaż rezerwowa</h3>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p>Ryzyka przejścia między umowami i struktura pytań o koszty.</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph -->
<p><a href="/category/sprzedaz-rezerwowa/">Zobacz: sprzedaż rezerwowa</a></p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
</div>
<!-- /wp:group -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Najnowsze artykuły"},"templateLock":"contentOnly","className":"gdp-section"} -->
<div class="wp-block-group gdp-section">
<!-- wp:heading -->
<h2 class="wp-block-heading">Najnowsze artykuły</h2>
<!-- /wp:heading -->
<!-- wp:query {"queryId":3,"query":{"perPage":6,"pages":0,"offset":0,"postType":"post","order":"desc","orderBy":"date","author":"","search":"","exclude":[],"sticky":"exclude","inherit":false,"taxQuery":{"category":[51,52,53,54,55]}},"className":"gdp-market-query"} -->
<div class="wp-block-query gdp-market-query">
<!-- wp:post-template -->
<!-- wp:group {"metadata":{"name":"Karta wpisu"},"templateLock":"contentOnly","className":"gdp-market-card"} -->
<div class="wp-block-group gdp-market-card">
<!-- wp:paragraph {"className":"gdp-data-note"} -->
<p class="gdp-data-note">[[data]] · Artykuł roboczy</p>
<!-- /wp:paragraph -->
<!-- wp:post-title {"level":3,"isLink":true} /-->
<!-- wp:post-excerpt {"moreText":"Czytaj artykuł"} /-->
<!-- wp:paragraph {"className":"gdp-author"} -->
<p class="gdp-author">Autor: [[autor]]</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->

<!-- /wp:post-template -->
<!-- wp:query-no-results -->
<!-- wp:paragraph -->
<p>Ta kategoria czeka na pierwszy zatwierdzony materiał. Wróć do bazy wiedzy lub porozmawiaj z PBM.</p>
<!-- /wp:paragraph -->

<!-- /wp:query-no-results -->
</div>
<!-- /wp:query -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Znajdź odpowiedź"},"templateLock":"contentOnly","className":"gdp-section"} -->
<div class="wp-block-group gdp-section">
<!-- wp:heading -->
<h2 class="wp-block-heading">Znajdź odpowiedź</h2>
<!-- /wp:heading -->
<!-- wp:search {"label":"Szukaj w bazie wiedzy","showLabel":true,"placeholder":"Wpisz temat, np. prolongata","buttonText":"Szukaj","buttonUseIcon":false} /-->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Szukasz komentarza do rynku?"},"templateLock":"contentOnly","className":"gdp-section"} -->
<div class="wp-block-group gdp-section">
<!-- wp:heading -->
<h2 class="wp-block-heading">Szukasz komentarza do rynku?</h2>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p>Komentarze mają własne archiwum. Obecne wpisy są szablonami, nie opisem bieżących wydarzeń.</p>
<!-- /wp:paragraph -->
<!-- wp:buttons -->
<div class="wp-block-buttons">
<!-- wp:button {"className":"is-style-outline"} -->
<div class="wp-block-button is-style-outline"><a class="wp-block-button__link wp-element-button" href="/komentarz-rynkowy/">Zobacz komentarze rynkowe</a></div>
<!-- /wp:button -->
</div>
<!-- /wp:buttons -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Źródła i aktualizacja"},"templateLock":"contentOnly","className":"gdp-section"} -->
<div class="wp-block-group gdp-section">
<!-- wp:heading -->
<h2 class="wp-block-heading">Źródła i aktualizacja</h2>
<!-- /wp:heading -->
<!-- wp:list -->
<ul class="wp-block-list">
<!-- wp:list-item -->
<li>[[źródła wskazane osobno pod każdym artykułem]]</li>
<!-- /wp:list-item -->
</ul>
<!-- /wp:list -->
<!-- wp:paragraph {"className":"gdp-small"} -->
<p class="gdp-small">Ostatnia aktualizacja: [[data]]. Autor: [[autor]].</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph {"className":"gdp-small"} -->
<p class="gdp-small">Materiał roboczy. Zakres oferty i odwołania do źródeł wymagają zatwierdzenia przed publikacją.</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Następny krok"},"templateLock":"contentOnly","className":"gdp-section gdp-final"} -->
<div class="wp-block-group gdp-section gdp-final">
<!-- wp:block {"ref":103,"content":{"Tytuł CTA":{"content":"Przygotuj dane do rozmowy."},"Podtytuł CTA":{"content":"Faktura i obecna umowa pozwolą uporządkować pytania o Twój zakup gazu."}}} /-->
</div>
<!-- /wp:group -->
]]></content:encoded>
<excerpt:encoded><![CDATA[]]></excerpt:encoded>
<wp:post_id>205</wp:post_id>
