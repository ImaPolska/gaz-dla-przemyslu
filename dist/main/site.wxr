</item>
<item>
<title><![CDATA[Kontakt]]></title>
<link>https://gazdlaprzemyslu.example.invalid/kontakt/</link>
<dc:creator><![CDATA[admin]]></dc:creator>
<guid isPermaLink="false">https://gazdlaprzemyslu.example.invalid/?p=204</guid>
<description></description>
<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Otwarcie: Porozmawiajmy o zakupie gazu w Twojej firmie."},"templateLock":"contentOnly","className":"gdp-section gdp-product-hero"} -->
<div class="wp-block-group gdp-section gdp-product-hero">
<!-- wp:heading {"level":1} -->
<h1 class="wp-block-heading">Porozmawiajmy o zakupie gazu w Twojej firmie.</h1>
<!-- /wp:heading -->
<!-- wp:paragraph {"className":"gdp-lead"} -->
<p class="gdp-lead">Przygotuj informację o firmie, punktach poboru i temacie rozmowy. Kontakt ma pomóc ustalić, jakie dane są potrzebne do zapytania. W prototypie dane adresowe czekają na potwierdzenie, a formularz nie wysyła wiadomości.</p>
<!-- /wp:paragraph -->
<!-- wp:buttons -->
<div class="wp-block-buttons">
<!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/wgraj-fakture/">Wgraj fakturę</a></div>
<!-- /wp:button -->
</div>
<!-- /wp:buttons -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Dane kontaktowe"},"templateLock":"contentOnly","className":"gdp-section"} -->
<div class="wp-block-group gdp-section">
<!-- wp:heading -->
<h2 class="wp-block-heading">Dane kontaktowe</h2>
<!-- /wp:heading -->
<!-- wp:table -->
<figure class="wp-block-table"><table class="has-fixed-layout"><thead><tr><th>Kontakt</th><th>Dane do uzupełnienia</th></tr></thead><tbody><tr><td>Podmiot</td><td>PBM Sp. z o.o., Grupa IMA Polska</td></tr><tr><td>Adres / NIP / KRS / kapitał zakładowy</td><td>[[PBM Sp. z o.o., adres, NIP, KRS, kapitał zakładowy]]</td></tr><tr><td>E-mail</td><td>[[adres e-mail do kontaktu]]</td></tr><tr><td>Telefon</td><td>[[numer telefonu]]</td></tr><tr><td>Godziny obsługi</td><td>[[dni i godziny obsługi]]</td></tr></tbody></table></figure>
<!-- /wp:table -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Formularz kontaktowy: podgląd"},"templateLock":"contentOnly","className":"gdp-section"} -->
<div class="wp-block-group gdp-section">
<!-- wp:group {"metadata":{"name":"Slot: kontakt z pbm"},"templateLock":"contentOnly","className":"gdp-upload"} -->
<div class="wp-block-group gdp-upload">
<!-- wp:heading -->
<h2 class="wp-block-heading">Kontakt z PBM</h2>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p>Pola są makietą. Nie wpisuj ani nie wysyłaj danych osobowych.</p>
<!-- /wp:paragraph -->
<!-- wp:group {"metadata":{"name":"Pola demonstracyjne"},"templateLock":"contentOnly","className":"gdp-fields"} -->
<div class="wp-block-group gdp-fields">
<!-- wp:paragraph {"className":"gdp-field"} -->
<p class="gdp-field"><strong>Imię i firma</strong> [[dane kontaktowe]]</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph {"className":"gdp-field"} -->
<p class="gdp-field"><strong>E-mail</strong> [[adres e-mail]]</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph {"className":"gdp-field"} -->
<p class="gdp-field"><strong>Telefon</strong> [[numer telefonu]]</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph {"className":"gdp-field"} -->
<p class="gdp-field"><strong>Temat</strong> [[zakup gazu, umowa lub współpraca]]</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph {"className":"gdp-field"} -->
<p class="gdp-field"><strong>Wiadomość</strong> [[krótki opis potrzeb]]</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
<!-- wp:buttons -->
<div class="wp-block-buttons">
<!-- wp:button -->
<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="/kontakt/">Przejdź do danych kontaktowych</a></div>
<!-- /wp:button -->
</div>
<!-- /wp:buttons -->
<!-- wp:paragraph {"className":"gdp-prototype-note"} -->
<p class="gdp-prototype-note">Prototyp: pola są nieaktywne. Przycisk prowadzi do kontaktu i nie przesyła danych.</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph {"className":"gdp-consent"} -->
<p class="gdp-consent">[[treść zgody dostarczy zleceniodawca]]. <a href="/polityka-prywatnosci/">Polityka prywatności</a>.</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Lokalizacja"},"templateLock":"contentOnly","className":"gdp-section"} -->
<div class="wp-block-group gdp-section">
<!-- wp:heading -->
<h2 class="wp-block-heading">Lokalizacja</h2>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p>[[mapa: lokalizacja biura po potwierdzeniu adresu]]</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph -->
<p>Nie ładujemy mapy z zewnętrznego serwisu. Adres i wskazówki dojazdu: [[do uzupełnienia]].</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Z czym chcesz przyjść?"},"templateLock":"contentOnly","className":"gdp-section"} -->
<div class="wp-block-group gdp-section">
