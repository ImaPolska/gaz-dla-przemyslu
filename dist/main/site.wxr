<item>
<title><![CDATA[Archiwum kategorii — szablon]]></title>
<link>https://gazdlaprzemyslu.example.invalid/archiwum-kategorii/</link>
<dc:creator><![CDATA[admin]]></dc:creator>
<guid isPermaLink="false">https://gazdlaprzemyslu.example.invalid/?p=225</guid>
<description></description>
<content:encoded><![CDATA[<!-- wp:group {"metadata":{"name":"Nagłówek archiwum kategorii"},"templateLock":"contentOnly","className":"gdp-section"} -->
<div class="wp-block-group gdp-section">
<!-- wp:query-title {"type":"archive","showPrefix":false,"level":1} /-->
<!-- wp:paragraph {"className":"gdp-lead"} -->
<p class="gdp-lead">Wybierz artykuł z tej kategorii. Treści robocze porządkują pytania do rozmowy; źródła i terminy oznaczone do weryfikacji wymagają zatwierdzenia.</p>
<!-- /wp:paragraph -->
<!-- wp:paragraph -->
<p><a href="/wiedza/">Wróć do wszystkich tematów</a></p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Materiały w tej kategorii"},"templateLock":"contentOnly","className":"gdp-section"} -->
<div class="wp-block-group gdp-section">
<!-- wp:heading -->
<h2 class="wp-block-heading">Materiały w tej kategorii</h2>
<!-- /wp:heading -->
<!-- wp:query {"queryId":3,"query":{"inherit":true},"className":"gdp-market-query"} -->
<div class="wp-block-query gdp-market-query">
<!-- wp:post-template -->
<!-- wp:group {"metadata":{"name":"Karta wpisu"},"templateLock":"contentOnly","className":"gdp-market-card"} -->
<div class="wp-block-group gdp-market-card">
<!-- wp:paragraph {"className":"gdp-data-note"} -->
<p class="gdp-data-note">[[data]] · Artykuł roboczy</p>
<!-- /wp:paragraph -->
<!-- wp:post-title {"level":3,"isLink":true} /-->
<!-- wp:post-excerpt {"moreText":"Czytaj artykuł"} /-->
<!-- wp:paragraph {"className":"gdp-author"} -->
<p class="gdp-author">Autor: [[autor]]</p>
<!-- /wp:paragraph -->
</div>
<!-- /wp:group -->

<!-- /wp:post-template -->
<!-- wp:query-no-results -->
<!-- wp:paragraph -->
<p>Ta kategoria czeka na pierwszy zatwierdzony materiał. Wróć do bazy wiedzy lub porozmawiaj z PBM.</p>
<!-- /wp:paragraph -->

<!-- /wp:query-no-results -->
</div>
<!-- /wp:query -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Nie znalazłeś odpowiedzi?"},"templateLock":"contentOnly","className":"gdp-section"} -->
<div class="wp-block-group gdp-section">
<!-- wp:heading -->
<h2 class="wp-block-heading">Nie znalazłeś odpowiedzi?</h2>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p>Brak wpisu nie oznacza braku możliwości rozmowy. Przygotuj dokumenty i pytania o zakup gazu.</p>
<!-- /wp:paragraph -->
<!-- wp:buttons -->
<div class="wp-block-buttons">
<!-- wp:button {"className":"is-style-outline"} -->
<div class="wp-block-button is-style-outline"><a class="wp-block-button__link wp-element-button" href="/wiedza/">Przejdź do bazy wiedzy</a></div>
<!-- /wp:button -->
</div>
<!-- /wp:buttons -->
</div>
<!-- /wp:group -->
<!-- wp:group {"metadata":{"name":"Następny krok"},"templateLock":"contentOnly","className":"gdp-section gdp-final"} -->
<div class="wp-block-group gdp-section gdp-final">
<!-- wp:block {"ref":103,"content":{"Tytuł CTA":{"content":"Przygotuj dane do rozmowy."},"Podtytuł CTA":{"content":"Faktura i obecna umowa pozwolą uporządkować pytania o Twój zakup gazu."}}} /-->
</div>
<!-- /wp:group -->
]]></content:encoded>
